# AI相談の設定ファイルです。設定画面から保存すると、このファイルが書き換わります。
# 手で書く場合は、このファイルを「.env」という名前でコピーしてください。
#
# OpenAI と ローカルは両方書いておけます。MANUAL_AI_PROVIDER でどちらを使うか決めます。
# このファイルはパスワードと同じ扱いです。共有したり社外に出したりしないでください。

# openai か local
MANUAL_AI_PROVIDER=openai

# ---- OpenAI を使う場合 ----
# キーは https://platform.openai.com/api-keys で発行できます。
OPENAI_API_KEY=
MANUAL_AI_MODEL=gpt-4o-mini

# ---- ローカルのAIを使う場合（Ollama など）----
# OPENAI_BASE_URL=http://localhost:11434/v1
# MANUAL_LOCAL_MODEL=qwen3:32b
# 長考を戻すと遅くなります。既定（未設定）のままを勧めます。
# MANUAL_LOCAL_THINK=1
